Connected Components = separate groups of vertices in a graph where every vertex in a group can be reached from every other vertex in that group.
Example:
2--1--3
4--5
7--6--8
9

To find the number of connected components in a group of vertices
Input:
9
5
1 2
1 3
4 5
6 7
6 8

Output:
4

Code:
import java.util.*;
public class Main {
    public static int connectedComponent(ArrayList<ArrayList<Integer>> graph,int vertex){
      boolean vis[]=new boolean[graph.size()];
      int count=0;
      for(int i=0;i<vertex;i++){
        if(!vis[i]){
          DFS(graph,vis,i);
          count++;
        }
      }
      return count;
    }
    public static void DFS(ArrayList<ArrayList<Integer>> graph,boolean[] vis,int start){
      vis[start]=true;
      for(int i:graph.get(start)){
        if(!vis[i]){
          DFS(graph,vis,i);
        }
      }
    }
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int ver=sc.nextInt();
      int e=sc.nextInt();
      ArrayList<ArrayList<Integer>> graph=new ArrayList<>();
      for(int i=0;i<=ver;i++){
        graph.add(new ArrayList<>());
      }
      for(int i=0;i<e;i++){
        int u=sc.nextInt();
        int v=sc.nextInt();
        graph.get(u).add(v);
        graph.get(v).add(u);  
      }
      System.out.print(connectedComponent(graph,ver));
    }
}

