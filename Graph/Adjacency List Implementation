Input:
6
7
1 2
1 4
2 3
2 5
3 6
4 5
5 6

Output:
1-> 2 4 
2-> 1 3 5 
3-> 2 6 
4-> 1 5 
5-> 2 4 6 
6-> 3 5 

Code:
import java.util.*;
public class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int ver=sc.nextInt();
      int e=sc.nextInt();
      ArrayList<ArrayList<Integer>> graph=new ArrayList<>();
      for(int i=0;i<=ver;i++){
        graph.add(new ArrayList<>());
      }
      for(int i=0;i<e;i++){
        int u=sc.nextInt();
        int v=sc.nextInt();
        graph.get(u).add(v);
        graph.get(v).add(u);  
      }
      for(int i=1;i<=ver;i++){
        System.out.print(i+"-> ");
        for(int vertex:graph.get(i)){
          System.out.print(vertex+" ");
        }
        System.out.println();
      }
    }
}
