Level order traversal of tree is the BFS traversal of a graph
Using queue
Using visited array

Input:
6
7
1 2
1 4
2 3
2 5
3 6
4 5
5 6

Output:
1 2 4 3 5 6 

Code:
import java.util.*;
public class Main {
    public static void BFS(ArrayList<ArrayList<Integer>> graph,int start){
      boolean[] vis=new boolean[graph.size()];
      Queue<Integer> q=new LinkedList<>();
      vis[start]=true;
      q.add(start);
      while(!q.isEmpty()){
        int vertex=q.poll();
        System.out.print(vertex+" ");
        for(int neighbour:graph.get(vertex)){
          if(!vis[neighbour]){
            vis[neighbour]=true;
            q.add(neighbour);
          }
        }
      }
    }
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int ver=sc.nextInt();
      int e=sc.nextInt();
      ArrayList<ArrayList<Integer>> graph=new ArrayList<>();
      for(int i=0;i<=ver;i++){
        graph.add(new ArrayList<>());
      }
      for(int i=0;i<e;i++){
        int u=sc.nextInt();
        int v=sc.nextInt();
        graph.get(u).add(v);
        graph.get(v).add(u);  
      }
      BFS(graph,1);
    }
}
