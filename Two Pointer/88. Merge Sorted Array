Input: 
nums1 = [1,2,3,0,0,0], m = 3, nums2 = [2,5,6], n = 3
Output: 
[1,2,2,3,5,6]

Code:
class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int j=0;
        for(int i=m;i<nums1.length;i++){             
            nums1[i]=nums2[j];
            j++;
        }
        for(int i=0;i<nums1.length;i++){
            for( j=i+1;j<nums1.length;j++){
               if(nums1[i]>nums1[j]){                //bubble sort
                int temp=nums1[i];
                nums1[i]=nums1[j];
                nums1[j]=temp;
               }
            }
        }
        
    }
}
