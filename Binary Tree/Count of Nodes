Using recursion:
class Solution {
    public int countNodes(Node root) {
        if(root==null){
            return 0;
        }
        return countNodes(root.left)+countNodes(root.right)+1;
    }

}

Using queue:
int countNodes(Node root) {

    if (root == null) {
        return 0;
    }
    Queue<Node> q = new LinkedList<>();
    q.add(root);

    int count = 0;

    while (!q.isEmpty()) {
        Node curr = q.poll();
        count++;

        if (curr.left != null) {
            q.add(curr.left);
        }
        if (curr.right != null) {
            q.add(curr.right);
        }
    }
    return count;
}
