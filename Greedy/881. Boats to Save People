Input: people = [1,2], limit = 3
Output: 1
Explanation: 1 boat (1, 2)

Input: people = [3,2,2,1], limit = 3
Output: 3
Explanation: 3 boats (1, 2), (2) and (3)

Input: people = [3,5,3,4], limit = 5
Output: 4
Explanation: 4 boats (3), (3), (4), (5)

Code:
//greedy 
//doesn't work for case [1,1,1,1] limit=4 >>> o/p:1 but returns 2
class Solution {
    public int numRescueBoats(int[] people, int limit) {
        int count=0;
        //sort so that we can use left and right ptrs to compare
        Arrays.sort(people);
        int right=people.length-1,left=0;
        while(left<=right){
            //sum of 1st and last is lesser than limit so move left
            if(people[left]+people[right]<=limit){
                left++;
            }
            //if a larger val on right is in limit but no smaller weight person can travel with them then move the last ptr forward and we use a separate boat for that.
            //eg:[2,2,3] limit=4 
            //    l   r ---> send 3 alone in a boat.
            right--;
            count++;
        }
        return count;
    }
}
