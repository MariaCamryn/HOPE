While del the root node the root node can be replaced with either left side’s right most ele (Maximum ele) or right side’s left most ele(Minimum ele)

Steps:
-find the val;
No children:
-if u have 0 children return null (condition= if(root.left==null&&root.right==null)return null;)
-if u have 1 children

static node del(int val,node root){
        if(root==null){
            return null;
        }
        else if(val<root.data){
            root.left=del(val,root.left);
        }
        else if(val>root.data){
            root.right=del(val,root.right);
        }//till this search
        else if(val==root.data){
            if(root.left==null&&root.right==null){           //no child
                return null;
            }
            else if(root.left!=null && root.right==null){
                return root.left;                                        //left child alone
            }
            else if(root.left==null && root.right!=null){
                return root.right;                                     //right child alone
            }
            else{	                                                      //has 2 child
                node temp=root.right;
                while(temp.left!=null){
		temp = temp.left;
		}
                 root.data=temp.data;                        //replace
                 root.right=del(temp.data,root.right);  
            }
            return root;
        }
    }
