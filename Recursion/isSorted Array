To check if an array is sorted or not without using built-in function.
Using Recursion
Using two pointers

Code:
import java.util.*;
public class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n=sc.nextInt();
      int[] arr=new int[n];
      for(int i=0;i<n;i++){
        arr[i]=sc.nextInt();
      }
      int i=0;
      int j=1;
      if(isSorted(arr,n,i,j)){
        System.out.print("Sorted");
      }
      else{
        System.out.print("Not Sorted");
      }
    }
    private static boolean isSorted(int[] arr,int n,int i,int j){
      if(j==n){
        return true;
      }
      if(arr[i]<=arr[j]){
        return isSorted(arr,n,i+1,j+1);
      }
      return false;
    }
}
