To remove a substring from a given string
Using recursion
Using substring
Input
aabcatacg
cat
Output
aabacd

Code:
import java.util.Scanner;
public class Main {
    static String removeSubstring(String str, String sub) {
        int index = str.indexOf(sub);
        if (index == -1) {  
            return str;
        }
        String newStr = str.substring(0, index)
                       + str.substring(index + sub.length());
        return removeSubstring(newStr, sub);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String str = sc.nextLine();
        String sub = sc.nextLine();
        System.out.println(removeSubstring(str, sub));
    }
}
