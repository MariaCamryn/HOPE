For an input n
if n==reverse(n):
  then n is a Palindrome Number

Code:
import java.util.*;
public class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n=sc.nextInt();
      int rev=0;
      rev=reverse(n,rev);
      if(n==rev){
        System.out.print("YES");
      }
      else{
        System.out.print("NO");
      }
    }
    private static int reverse(int n,int rev){
      if(n==0){
        return rev;
      }
      rev=rev*10+n%10;
      return reverse(n/10,rev);
    }
}
