Leetcode No: 37
To fill places with . dots with valid number to form a valid sudoku
using backtracking
using recursion

Note:
            int row=3*(r/3)+i/3;    //to check 3x3
            int col=3*(c/3)+i%3;
here r/3 and c/3 finds the 3x3 box in the 9x9 box
multiplying it with 3 gives the 0,0 of that 3x3 box
i/3 gives 0 0 0 1 1 1 2 2 2
i%3 gives 0 1 2 0 1 2 0 1 2

Code:
class Solution {
    public void solveSudoku(char[][] board) {
        solve(board);
    }
    private boolean solve(char[][] board){
        for(int i=0;i<9;i++){
            for(int j=0;j<9;j++){
                if(board[i][j]=='.'){
                    for(char ch='1';ch<='9';ch++){
                        if(isValid(board,i,j,ch)){
                            board[i][j]=ch;
                            if(solve(board)){
                                return true;
                            }
                            board[i][j]='.';
                        }
                    }
                    return false;
                }
            }
        }
        return true;
    }
    private boolean isValid(char[][] board,int r,int c,char ch){
        for(int i=0;i<9;i++){
            if(board[r][i]==ch){    //row check
                return false;
            }
            if(board[i][c]==ch){    //column check
                return false;
            }
            int row=3*(r/3)+i/3;    //to check 3x3
            int col=3*(c/3)+i%3;
            if(board[row][col]==ch){
                return false;
            }
        }
        return true;
    }
}



